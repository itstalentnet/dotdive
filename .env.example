# ─── dotdive environment ─────────────────────────────────────────
# کپی کن به `.env` و مقادیر واقعی را بگذار. هیچ سکرت واقعی باید در ریپو نماند.

# آدرس نهایی سایت (بدون اسلش پایانی)
SITE_URL=http://localhost:3000

# سکرت امضای نشست و HMAC کدهای OTP (حداقل ۳۲ کاراکتر تصادفی)
AUTH_SECRET=change-me-to-a-long-random-string

# ─── ورود با گوگل (OAuth 2.0 / OIDC) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# redirect_uri همیشه: {SITE_URL}/api/auth/google/callback

# ─── ایمیل (ارسال کد یک‌بارمصرف) ─────────────────────────────────
# اگر خالی باشد، در حالت توسعه کد در طول‌لاگ چاپ می‌شود.
EMAIL_FROM="dotdive <login@dotdive.ir>"
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER="resend" # یا smtp

# ذخیرهٔ موقت (OTP و rate limit). خالی = حافظهٔ داخلی (فقط single instance)
#STORE_URL=rediss://user:pass@host:6379
#STORE_URL=file:./data/store.sqlite

# ─── دسترسی ریشه‌های خصوصی ───────────────────────────────────────
# همهٔ ریشه‌های خصوصی
ACCESS_ALL=
# دسترسی به یک ریشه (نام پوشه به بزرگ، خط تیره → زیرخط)
ACCESS_NONS=
ACCESS_LEMMO=

# ─── سئو (اختیاری) ──────────────────────────────────────────────
#GOOGLE_SITE_VERIFICATION=