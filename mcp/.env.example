# Mode switch
MCP_TRANSPORT=stdio          # "stdio" | "http"

# Docs source
DOCS_ROOT=../docs             # path to the docs/ folder, relative to mcp/

# Local-only override (optional)
ALLOWED_PROJECTS=             # empty = all projects visible

# Remote-only (used only when MCP_TRANSPORT=http)
HTTP_HOST=127.0.0.1
HTTP_PORT=3900
TOKENS_FILE=./tokens.json     # JSON store with static tokens or OAuth clients
MCP_OAUTH_SECRET=             # Optional signing secret for OAuth 2.0 JWT tokens (auto-generated if empty)
MCP_PUBLIC_URL=               # Optional public base URL (e.g. https://mcp.dotdive.ir) for OAuth discovery metadata